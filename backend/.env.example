NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password
DB_NAME=homecare_central
DB_SSL=false

# Auth
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Frontend origin
CLIENT_ORIGIN=http://localhost:3000

# Seeded development accounts
SEED_ADMIN_EMAIL=admin@homecare.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Admin
SEED_DEFAULT_USERS=true
SEED_STAFF_EMAIL=staff@homecare.local
SEED_STAFF_PASSWORD=Staff@12345
SEED_CAREGIVER_EMAIL=caregiver@homecare.local
SEED_CAREGIVER_PASSWORD=Caregiver@12345
SEED_CLIENT_EMAIL=client@homecare.local
SEED_CLIENT_PASSWORD=Client@12345
SEED_HR_EMAIL=hr@homecare.local
SEED_HR_PASSWORD=Hr@12345678

# Caregiver password created by HR when applicant is hired
HIRED_CAREGIVER_DEFAULT_PASSWORD=Test@1234
RATE_LIMIT_DISABLED=false
